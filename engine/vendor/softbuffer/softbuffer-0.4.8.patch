+pub(crate) fn display_color_space() -> Option<CFRetained<CGColorSpace>> {
+    extern "C" {
+        fn CGMainDisplayID() -> u32;
+        fn CGDisplayCopyColorSpace(display: u32) -> *mut CGColorSpace;
+    }
+    // SAFETY: функции CoreGraphics; Copy возвращает объект с +1 — отдаём его CFRetained
+    let raw = unsafe { CGDisplayCopyColorSpace(CGMainDisplayID()) };
