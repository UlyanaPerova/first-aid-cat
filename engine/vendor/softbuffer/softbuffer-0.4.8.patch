+
+/// Number of pixels for a frame, or `None` if the byte size would overflow.
+fn frame_len(width: usize, height: usize) -> Option<usize> {
+    let n = width.checked_mul(height)?;
+    n.checked_mul(size_of::<u32>())?;
+    // CGImage row stride is `width * 4`.
+    width.checked_mul(4)?;
+    Some(n)
+}
+
+/// Switch the pool to frames of `n` pixels, freeing buffers of any other size.
+fn pool_set_len(n: usize) {
+    if POOL_LEN.swap(n, Ordering::Relaxed) != n {
+        if let Ok(mut p) = POOL.lock() {
+            p.retain(|b| b.len() == n);
+        }
+    }
+}
