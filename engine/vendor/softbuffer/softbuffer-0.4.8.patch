+/// Аптечка: ICC-профиль того же пространства, которым помечаются пиксели слоя (см. `display_color_space`).
+pub(crate) fn display_icc() -> Option<Vec<u8>> {
+    let space = display_color_space()?;
+    let data = CGColorSpace::icc_data(Some(&space))?;
+    Some(data.to_vec())
+}
